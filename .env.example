# ==============================================================================
# StudyGAI Backend Environment Configuration (NotebookLM+ 100M-Scale RAG)
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
mongoURI=mongodb://localhost:27017/sage-db
localURI=mongodb://localhost:27017/sage-db

# Authentication
JWTKey=your_super_secret_jwt_key_change_in_production
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_secret

# Redis (Caching + BullMQ Async Ingestion Queue)
REDIS_URL=redis://localhost:6379
ENABLE_BULLMQ=true
INGESTION_CONCURRENCY=4

# Qdrant Vector Database (Hybrid Dense + Sparse + Tiered Multitenancy)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant_key_secret
QDRANT_COLLECTION=source_chunks
# Quantization: scalar (INT8, 4x RAM savings) | binary (1-bit, 32x RAM savings + NVMe rescore) | none
QDRANT_QUANTIZATION=scalar
# Sharding: auto (single-node dev) | custom (distributed cluster with deterministic shard_key routing)
QDRANT_SHARDING_MODE=auto
QDRANT_SHARD_COUNT=16
QDRANT_REPLICATION_FACTOR=1

# Horizontal Multi-Replica WebSockets (Socket.IO Redis Pub/Sub Adapter)
ENABLE_REDIS_WS_ADAPTER=true

# Hot -> Cold Vector Tiering (archive idle notebooks to S3/R2 gzipped snapshots)
ENABLE_VECTOR_TIERING_CRON=false
VECTOR_TIERING_INTERVAL_HOURS=6
VECTOR_COLD_AFTER_DAYS=30

# Distributed Rate Limiting (requests per minute per user/IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_RPM=60
RATE_LIMIT_INGEST_RPM=30
RATE_LIMIT_STUDIO_RPM=20
RATE_LIMIT_GLOBAL_RPM=300

# Operations & Prometheus Observability Tokens (optional in dev, REQUIRED in production)
# OPS_ADMIN_TOKEN=
# METRICS_BEARER_TOKEN=

# Self-Hosted Python RAG Worker (Parsing, OCR, Scraping, Embeddings, Reranking)
RAG_WORKER_URL=http://localhost:5000
DOCLING_SERVICE_URL=http://localhost:5000

# Model Profile:
# - cpu (default local dev): FastEmbed BAAI/bge-small-en-v1.5 (384d) + BM25 + FlashRank
# - gpu (prod SOTA): BAAI/bge-m3 (1024d) + BAAI/bge-reranker-v2-m3 (or TEI/Infinity)
RAG_PROFILE=cpu
VECTOR_DIM=384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Optional Dedicated GPU Serving (HuggingFace TEI / Infinity) or Cloud Providers
# EMBEDDING_SERVER_URL=http://tei:8080
# RERANKER_SERVER_URL=http://tei-rerank:8081
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=text-embedding-3-small
# RERANK_API_URL=https://api.cohere.com/v2/rerank
# RERANK_API_KEY=
# RERANK_API_MODEL=rerank-v3.5

# Object Storage (local content-sharded disk OR s3 / MinIO / Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads/object-store
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=studygai-sources
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Multi-Provider LLM Gateway (groq | gemini | openai | custom)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Set GEMINI_API_KEY to automatically route large-notebook synthesis to 1M-token Gemini!
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI or Custom OpenAI-compatible (vLLM / Ollama / OpenRouter)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
